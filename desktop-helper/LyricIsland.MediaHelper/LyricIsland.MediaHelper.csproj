<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LyricIsland.MediaHelper</AssemblyName>
    <RootNamespace>LyricIsland.MediaHelper</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Publicación: primero Native AOT (requiere las herramientas de C++ de VS);
         si no están, `-p:PublishAot=false` publica self-contained + trimmed (ver README). -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LyricIsland.MediaHelper.Tests" />
  </ItemGroup>
</Project>
